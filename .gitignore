# Credentials — never commit.
.env
.env.*
!.env.example

# graphify outputs (regenerable; can be large)
graphify-out/
**/graphify-out/

# Python
.venv/
__pycache__/
*.egg-info/

# Generated MCP config contains the Neo4j password.
.mcp.json

# Per-arm MCP configs for the harness: treatment's carries the password,
# kgc's carries machine-specific absolute paths. Named explicitly, not by
# glob, so verify/empty-mcp.json (tracked, carries neither) stays tracked.
verify/treatment-mcp.json
verify/kgc-mcp.json

# Task 7 verification harness: raw per-run data the human produces by
# actually running verify/run_arm.py. The harness itself (questions.md,
# results.md, run_arm.py, empty-mcp.json, runs/.gitkeep) stays tracked.
verify/runs/*.json
verify/results.csv

# Review working notes, OS and tool litter.
.superpowers/
.DS_Store
.pytest_cache/
